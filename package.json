{
  "name": "@ostro/auth",
  "version": "1.0.1",
  "description": "Authentication module for OstroJS",
  "main": "build/authManager.js",
  "types": "build/authManager.d.ts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/authManager.d.ts",
      "default": "./build/authManager.js"
    },
    "./*": {
      "types": "./build/*.d.ts",
      "default": "./build/*.js"
    }
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "npx c8 npx jest"
  },
  "dependencies": {
    "@ostro/contracts": "^1.0.2",
    "@ostro/support": "^1.0.11",
    "commander": "^15.0.0",
    "string-argv": "^0.3.2",
    "uid-safe": "^2.1.5"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "engineStrict": true,
  "keywords": [
    "auth",
    "authentication",
    "api authentication",
    "authentication guard",
    "session authentication"
  ],
  "author": "amar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostrojs/auth.git"
  },
  "bugs": {
    "url": "https://github.com/ostrojs/auth/issues"
  },
  "homepage": "https://github.com/ostrojs/auth#readme"
}
